{
  "name": "tutorial",
  "description": "Screen-recording safe: preserves text readability, cursor, and UI; avoids unnecessary crops or overlays.",
  "max_events_per_15s": 2,
  "max_transitions_per_15s": 1,
  "strong_accent_cooldown_s": 4.0,
