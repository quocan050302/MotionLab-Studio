{
  "name": "tutorial",
  "description": "Screen-recording safe policy: preserves text/cursor/UI readability, avoids unnecessary cropping or busy overlays.",
  "max_accents_per_15s": 2,
  "max_transitions_per_15s": 1,
  "intensity_scale": 0.65,
  "min_strong_spacing_s": 3.2,
  "same_effect_cooldown_s": 7.5,
  "same_family_cooldown_s": 3.2,
  "allow_subject_zoom": false,
  "allow_layout_masks": false,
  "allow_split_layout": false,
  "allow_audio_reactive": false,
  "protect_edges_strict": true,
  "preferred_families": ["color", "graphics", "transition"]
}
