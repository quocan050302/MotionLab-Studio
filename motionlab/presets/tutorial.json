  "protect_edges_strict": true,
  "preferred_families": ["color_optical", "transition", "camera"],
  "blocked_effects": ["subject_punch_in", "subject_follow_pan", "tilt_micro", "settle_bounce", "depth_shadow_push", "rounded_mask_reveal", "circular_focus_mask", "diagonal_mask_sweep", "split_composition", "full_to_inset", "inset_to_full", "foreground_frame_accent", "offset_layer_echo", "geometric_window", "edge_lines", "ring_accent", "directional_shapes", "ambient_particles", "pulse_border", "film_grain_subtle", "soft_glow"]
