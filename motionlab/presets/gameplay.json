{
  "name": "gameplay",
  "description": "Preserves HUD/edges; avoids zoom on high-motion segments; allows mild grading and real-cut transitions.",
  "max_events_per_15s": 3,
  "max_transitions_per_15s": 2,
  "strong_accent_cooldown_s": 3.0,
