{
  "name": "storytelling",
  "description": "Longer deliberate holds, subtle mood color shifts, restrained dissolves, minimal graphic clutter.",
  "max_accents_per_15s": 3,
  "max_transitions_per_15s": 2,
  "intensity_scale": 0.80,
  "min_strong_spacing_s": 2.8,
